{
  "name": "equilibrium-css",
  "version": "1.0.0",
  "description": "Equilibrium CSS styles",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./index.css": "./index.css",
    "./index": "./index.css"
  },
  "files": [
    "dist",
    "index.css"
  ],
  "scripts": {
    "build": "npm run clean && npm run build:scss && tsup-node",
    "build:scss": "sass scss:. --no-source-map",
    "clean": "rimraf dist",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "glob": "^11.0.2",
    "sass": "1.77.3",
    "tsup": "^8.4.0"
  },
  "dependencies": {
    "postcss": "^8.5.3"
  }
}
